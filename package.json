{
  "name": "webtranslator-pc",
  "version": "2.0.0",
  "description": "WebTranslator 电脑版 — 网页/游戏本地化翻译工具（前端 + Node.js 包装）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node main.js",
    "dist": "electron-builder --win nsis"
  },
  "author": "WebTranslator",
  "license": "MIT",
  "dependencies": {
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.webt.webtranslator",
    "productName": "WebTranslator",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "server/**",
      "node_modules/undici/**",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WebTranslator",
      "artifactName": "WebTranslator-Setup-${version}.${ext}"
    }
  }
}
